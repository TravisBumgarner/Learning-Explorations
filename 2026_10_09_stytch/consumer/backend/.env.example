# Postgres (see ../docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=54923
DATABASE_NAME=consumer
DATABASE_USER=consumer
DATABASE_PASSWORD=consumer

# Stytch backend credentials (dashboard > API keys). Not the public token.
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Connected App credentials issued by the Provider's Stytch project.
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=
# Provider project domain (Stytch dashboard > Project Overview > Project Domain).
PROVIDER_ISSUER=
