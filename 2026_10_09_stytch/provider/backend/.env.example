# Postgres (see ../docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=54817
DATABASE_NAME=provider
DATABASE_USER=provider
DATABASE_PASSWORD=provider

# Stytch backend credentials (dashboard > API keys). Not the public token.
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Connected App credentials issued by Consumer's Stytch project.
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=
# Consumer project domain (Stytch dashboard > Project Overview > Project Domain).
PROVIDER_ISSUER=
